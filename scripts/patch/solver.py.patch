"""
  Custom code:
"""
from jax import custom_vjp, custom_jvp

def _get_solver_functions(m, d):
  def cond(ctx: Context) -> jax.Array:
    improvement = _rescale(m, ctx.prev_cost - ctx.cost)
    gradient = _rescale(m, math.norm(ctx.grad))
    done = ctx.solver_niter >= m.opt.iterations
    done |= improvement < m.opt.tolerance
    done |= gradient < m.opt.tolerance
    return ~done

  def body(ctx: Context) -> Context:
    ctx = _linesearch(m, d, ctx)
    prev_grad, prev_Mgrad = ctx.grad, ctx.Mgrad
    ctx = _update_constraint(m, d, ctx)
    ctx = _update_gradient(m, d, ctx)

    if m.opt.solver == SolverType.NEWTON:
      search = -ctx.Mgrad
    else:
      # polak-ribiere:
      beta = jp.dot(ctx.grad, ctx.Mgrad - prev_Mgrad)
      beta = beta / jp.maximum(mujoco.mjMINVAL, jp.dot(prev_grad, prev_Mgrad))
      beta = jp.maximum(0, beta)
      search = -ctx.Mgrad + beta * ctx.search
    ctx = ctx.replace(search=search, solver_niter=ctx.solver_niter + 1)
    return ctx
  
  return cond, body

# Default behavior and Forward mode friendly:
def _solve_fwd_impl(m, d, ctx):
  cond, body = _get_solver_functions(m, d)   
  return jax.lax.while_loop(cond, body, ctx)

# Reverse mode friendly:
def _solve_bwd_impl(m, d, ctx):
  cond, body = _get_solver_functions(m, d)        
  return _while_loop_scan(cond, body, ctx, max_iter=m.opt.iterations)

@custom_vjp
def _solve_vjp(m, d, ctx):
  return _solve_fwd_impl(m, d, ctx)

def _solve_vjp_fwd(m, d, ctx):
  ctx_final = _solve_fwd_impl(m, d, ctx)
  return ctx_final, (m, d, ctx)

def _solve_vjp_bwd(residuals, g):
  m, d, ctx = residuals
  
  def scan_wrapper(m_in, d_in, ctx_in):
    return _solve_bwd_impl(m_in, d_in, ctx_in)

  _, vjp_fn = jax.vjp(scan_wrapper, m, d, ctx)
  
  grad_m, grad_d, grad_ctx = vjp_fn(g)

  return (grad_m, grad_d, grad_ctx, None, None)

_solve_vjp.defvjp(_solve_vjp_fwd, _solve_vjp_bwd)

@custom_jvp
def solve_wrapper(m, d, ctx):
  return _solve_vjp(m, d, ctx)

@solve_wrapper.defjvp
def _solve_jvp(primals, tangents):
  return jax.jvp(_solve_fwd_impl, primals, tangents)